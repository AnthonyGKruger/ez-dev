# Copy to .env and fill in the values. `.env` is gitignored.
# The NUXT_PUBLIC_* names are kept from the Nuxt site so the variables already
# set on Vercel keep working; VITE_* equivalents work too.

# Canonical site URL (canonical links, Open Graph). Defaults to production.
NUXT_PUBLIC_SITE_URL=https://www.ezdev.solutions

# Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to disable.
NUXT_PUBLIC_GTM_ID=

# EmailJS public key (dashboard > Account > API keys), used by the contact form.
NUXT_PUBLIC_EMAIL_JS_SECURE_TOKEN=

# Cloudflare Turnstile. The site key is public; the secret is server-only
# (used by /api/turnstile-verify). For local dev use Cloudflare's test keys:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
